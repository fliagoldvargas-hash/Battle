VITE_PRIVY_APP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
SUPABASE_CRON_SECRET=
VITE_BATTLE_NETWORK=mainnet
BATTLE_NETWORK=mainnet
BATTLE_SETTLEMENT_MODE=treasury
VITE_BATTLE_SETTLEMENT_MODE=treasury
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ESCROW_PROGRAM_ID=
