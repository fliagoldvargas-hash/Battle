# Public address only. This is the dedicated Privy Mainnet treasury that
# receives player deposits; do not put a wallet secret in any .env file.
ESCROW_TREASURY_ADDRESS=
ESCROW_TREASURY_WALLET_ID=
# Privy wallet material is never stored here. PRIVY_APP_SECRET and the scoped
# authorization signer are encrypted server-only Vercel secrets.
PRIVY_TREASURY_AUTHORIZATION_KEY=
PRIVY_TREASURY_AUTHORIZATION_PUBLIC_KEY=
ESCROW_REQUIRED=true
# Public Solana address allowed to manage the holder-token CA and fee tiers.
# Configure this separately for Devnet and, later, Mainnet.
PROTOCOL_ADMIN_WALLET=
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_ESCROW_TREASURY_ADDRESS=
